{
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "es2022", "deno.ns"]
  },
  "imports": {
    "@rgrannell1/peach": "../../peach.ts/src/mod.ts",
    "@rgrannell1/tribbledb": "../../tribbledb/src/mod.ts",
    "@rgrannell1/tribbledb/v2": "../../tribbledb/src/v2/mod.ts"
  },
  "lint": {
    "plugins": ["./lint-plugins/no-single-letter-vars.ts"],
    "include": ["ts/", "tests/", "workers/", "lint-plugins/"],
    "exclude": ["node_modules/", "dist/", "search-engine/"],
    "rules": {
      "include": [
        "explicit-module-boundary-types",
        "guard-for-in",
        "no-eval",
        "no-non-null-asserted-optional-chain",
        "no-self-compare",
        "no-sparse-arrays",
        "no-sync-fn-in-async-fn",
        "no-throw-literal",
        "no-useless-rename",
        "verbatim-module-syntax"
      ],
      "exclude": [
        "no-window",
        "no-window-prefix",
        "no-import-prefix",
        "no-unversioned-import",
        "no-process-global"
      ]
    }
  }
}
