/*
  Permissions-Policy: web-share=*
  X-Frame-Options: DENY
  X-XSS-Protection: 1; mode=block
  X-Content-Type-Options: nosniff

# build-id in the filename busts the cache on change
/dist/*
  Cache-Control: public, max-age=31536000, immutable

# the worker filename is stable, so the CDN edge must always revalidate it
/sw.js
  Cache-Control: public, max-age=0, must-revalidate

# publication-id in the filename busts the cache on change
/manifest/tribbles.*
  Cache-Control: public, max-age=31536000, immutable

# publication-id in the filename busts the cache on change
/manifest/stats.*
  Cache-Control: public, max-age=31536000, immutable

# content-hashed pages; only atom-index.xml stays revalidated
/manifest/atom/atom-page-*
  Cache-Control: public, max-age=31536000, immutable

# flags are immutable: a redesigned flag must ship under a new filename
/flags/*
  Cache-Control: public, max-age=31536000, immutable

# icons change rarely: cache for a month
/icons/*
  Cache-Control: public, max-age=2592000
/favicon.ico
  Cache-Control: public, max-age=2592000
/favicon-32x32.png
  Cache-Control: public, max-age=2592000

# version in the directory name busts the cache on change
/vendor/*
  Cache-Control: public, max-age=31536000, immutable

# fonts are immutable: a changed font must ship under a new filename
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
